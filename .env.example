# ── 앱(번들) ─────────────────────────────────────────────
# 공개 API HTTPS 기본 주소 (예: https://bluecl.cloud/tibo). 로컬은 비워 두면 Vite proxy를 사용해요.
VITE_API_BASE_URL=
# 기능성 캠페인 발송 코드(동의 화면에도 사용). 반드시 `tibo-`로 시작해요.
VITE_TOSS_RESET_TEMPLATE=tibo-reset
VITE_TOSS_PLAN_TEMPLATE=tibo-plan

# ── API 서버 ─────────────────────────────────────────────
PORT=3002
HOST=127.0.0.1
ALLOWED_ORIGINS=https://tibo.apps.tossmini.com,https://tibo.private-apps.tossmini.com
# SQLite 파일. 서버에서는 릴리스 폴더 밖 절대 경로를 써요.
TIBO_DB_PATH=.data/tibo.sqlite

# ── 앱인토스 파트너 API (mTLS) ───────────────────────────
# 콘솔 > 개발 > mTLS 인증서에서 받은 PEM 파일 경로. 저장소에 올리지 마세요.
TOSS_MTLS_CERT=
TOSS_MTLS_KEY=
# 리셋 완료 / 리셋 예고 기능성 메시지 템플릿 코드
TOSS_RESET_TEMPLATE=
TOSS_PLAN_TEMPLATE=
# true면 토스 API 대신 가짜 응답을 써요. 로컬 개발 전용이며 운영에서는 거부돼요.
TOSS_MOCK=true

# ── X(트위터) 수집 ───────────────────────────────────────
# X API v2 App-only Bearer 토큰 (pay-per-use). 비우면 수집하지 않아요.
X_BEARER_TOKEN=
X_USERNAME=thsottiaux
X_USER_ID=1953337039510003712
# 이 시간(분)보다 오래된 게시물은 알림을 보내지 않아요.
NOTIFY_MAX_AGE_MIN=90
# auto: 확실한 리셋은 즉시 발송 / review: 모두 운영자 승인 후 발송
NOTIFY_MODE=auto
